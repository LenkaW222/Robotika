from ctu_mitsubishi import Rv6s
import cv2
import os
import numpy as np

# Inicializace rozhraní robota
robot = Rv6s(debug=False)
robot.initialize()

def move_bot(position):
    if position is None:
        robot.stop_robot()
        robot.close_connection()
        exit()

    q0 = robot.get_q()
    print(q0)
    qs = robot.ik(position)

    qnew = min(qs, key=lambda q: np.linalg.norm(q-q0))


    print("q new: ", end=" ")
    print(qnew)

    steps = 1

    for i in range(steps):
        qmove = q0 - (q0-qnew)*(i/(steps-1))
        robot.move_to_q(qmove)
        robot.wait_for_motion_stop()
        sleep(0.1)
        print("steps(" + str(i) + "/" + str(steps)+"), ", end = "")
        print(qmove)
    print("moved", end = "\n\n")


for i in range (10):
    for j in range(5):
        position = np.array(
        [[1, 0, 0, 0.3 + i*0.04],
        [0, -1, 0, -0.2+j*0.1],
        [0, 0, -1, 0.1],
        [0, 0, 0, 1]])

        move_bot(position)
        
        img = robot.grab_image()
        if img is not None:
            os.makedirs('photos_3_11_26', exist_ok=True)

            success = cv2.imwrite('photos_3_11_26/img'+str(i) + str(j) +'.png', img)

            with open('photos_3_11_26/positions.txt', 'w') as f:
            f.write(str(position))

        position = None


robot.stop_robot()
robot.close_connection()